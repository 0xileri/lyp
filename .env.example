# ---------------------------------------------------------------------------
# Binance Agent OS connection
# ---------------------------------------------------------------------------
# TODO(agent-os): both values come from https://binance.com/agent-os .
# The transport, auth header, session handling and read-only tool gating are
# all implemented; these two strings are the only unknowns. See
# src/agentos/client.js for the single place they are consumed.
AGENT_OS_MCP_URL=
AGENT_OS_TOKEN=

# Issued to you by Binance. Agent OS offers no dynamic client registration,
# so this cannot be obtained automatically. Register the callback URL
# https://<your-domain>/callback against it, then visit /connect.
AGENT_OS_CLIENT_ID=

# Run without a live Agent OS connection, against test/fixtures.js.
# The rules engine is identical in both modes.
GUARDRAIL_PROVIDER=fixture   # fixture | agentos

# ---------------------------------------------------------------------------
# Narration (optional, never load-bearing)
# ---------------------------------------------------------------------------
# Omit the key entirely to run with narration disabled; verdicts are unaffected.
#
# Anthropic directly:
#   NARRATION_API_KEY=sk-ant-...
#   NARRATION_MODEL=claude-sonnet-5
#
# Through a gateway that speaks the Anthropic wire format (e.g. Orbio).
# The base ends at /api, not /api/v1, because Anthropic-shaped clients append
# /v1/messages themselves. Gateways take their own model ids -- Orbio uses
# OpenRouter ids -- so NARRATION_MODEL must be set, not inherited.
#   NARRATION_API_KEY=<your orbio key>
#   NARRATION_BASE_URL=https://api.orbio.so/api
#   NARRATION_MODEL=anthropic/claude-sonnet-4.5
NARRATION_API_KEY=
NARRATION_BASE_URL=
NARRATION_MODEL=claude-sonnet-5
NARRATION_TIMEOUT_MS=4000

# Read as a fallback when NARRATION_API_KEY is unset. Prefer the name above:
# a gateway key in a variable named after Anthropic is how the wrong
# credential ends up in the wrong place.
ANTHROPIC_API_KEY=

PORT=3000
